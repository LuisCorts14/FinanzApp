# Usados por docker-compose para levantar el contenedor de Postgres
POSTGRES_USER=finanzapp
POSTGRES_PASSWORD=finanzapp
POSTGRES_DB=finanzapp
POSTGRES_PORT=15432
# En Windows, si el 5432 está reservado por el rango dinámico de puertos, usa otro (ej. 15432)

# Usado por la app FastAPI para conectarse (debe coincidir con los valores de arriba)
DATABASE_URL=postgresql://finanzapp:finanzapp@localhost:15432/finanzapp
PROJECT_NAME=FinanzApp
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string

# Recuperacion de contraseña (Resend: https://resend.com)
FRONTEND_URL=http://localhost:5173
# Correos de recuperación de contraseña. Gratis: un Gmail dedicado + contraseña de aplicación.
SMTP_USER=
SMTP_PASSWORD=
# Alternativa: Resend (para enviar a cualquier correo necesita un dominio verificado).
RESEND_API_KEY=
EMAIL_FROM=FinanzApp <onboarding@resend.dev>

# Escanear boleta con Claude (https://console.anthropic.com). Sin key, la función queda desactivada.
ANTHROPIC_API_KEY=
RECEIPT_SCANS_PER_DAY=10
# claude-haiku-5-5 (por defecto, el más barato) o claude-opus-5-5 (más preciso)
RECEIPT_MODEL=claude-haiku-5-5
